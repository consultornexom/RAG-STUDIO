{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nexom.com/knowledge-package/v1/metadata_schema.schema.json",
  "title": "MetadataSchemaBundle",
  "description": "metadata_schema.json completo: definiciones de campo (FieldDefinition) y catalogos (Catalog+CatalogEntry) auto-contenidos, de forma que source_metadata.jsonl sea interpretable sin acceso a RAG Studio.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version_local", "knowledge_base_id", "fields", "catalogs"],
  "properties": {
    "schema_version_local": { "type": "integer", "minimum": 1, "description": "Version del esquema de metadata DEL PROYECTO ORIGEN (MetadataSchema.version en RAG Studio) -- informativa, no confundir con schema_version del manifest." },
    "knowledge_base_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "Debe coincidir con manifest.json.knowledge_base_id -- NUNCA project_id (ver rc2)." },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "field_id", "display_name", "data_type", "required", "filterable", "multiple", "inherited_by_chunks"],
        "properties": {
          "id": { "type": "string", "pattern": "^urn:nexom:field:.+$" },
          "field_id": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "data_type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "filterable": { "type": "boolean" },
          "multiple": { "type": "boolean" },
          "inherited_by_chunks": { "type": "boolean" },
          "catalog_id": {
            "type": ["string", "null"],
            "pattern": "^urn:nexom:catalog:[0-9a-f-]{36}$",
            "description": "Obligatorio (no null) si data_type es uno de los tipos respaldados por catalogo."
          }
        }
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "entries"],
        "properties": {
          "id": { "type": "string", "pattern": "^urn:nexom:catalog:[0-9a-f-]{36}$" },
          "name": { "type": "string", "minLength": 1 },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value_code", "label", "parent_entry_code"],
              "properties": {
                "value_code": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "parent_entry_code": {
                  "type": ["string", "null"],
                  "description": "Referencia jerarquica a otro value_code DENTRO del mismo catalogo."
                }
              }
            }
          }
        }
      }
    }
  }
}
